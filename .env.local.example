# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — real secrets never get committed.

# Shared Neon Postgres connection string.
# This is the SAME database Happy Hour Finance uses. Grocery Run only ever
# touches the two shopping tables. Copy the value from
# ~/happy-hour-finance/.env.local or grab it from the Neon dashboard.
DATABASE_URL=

# Single-user lock (cookie session gate — see src/proxy.ts).
# Leave SESSION_SECRET blank for open local dev (no gate at all).
# Set all three in the deployed (Vercel) environment.
#
#   SESSION_SECRET  HMAC key that signs the session cookie; its presence turns
#                   the gate ON.               generate: openssl rand -base64 32
#   APP_TOKEN       The `?k=` secret baked into the iPhone home-screen icon URL
#                   (`/?k=<APP_TOKEN>`) for zero-typing unlock.
#                                              generate: openssl rand -hex 24
#   APP_PASSWORD    Fallback password for the /login page (laptop / recovery).
SESSION_SECRET=
APP_TOKEN=
APP_PASSWORD=

# (Obsolete — replaced by the cookie gate above. Safe to delete from Vercel.)
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=
